{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "/public/images/:path*"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/recipes/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/households/migrate-copy",
      "destination": "/api/household-api?householdRoute=migrate-copy"
    },
    {
      "source": "/api/households/activate",
      "destination": "/api/household-api?householdRoute=activate"
    },
    {
      "source": "/api/households/join",
      "destination": "/api/household-api?householdRoute=join"
    },
    {
      "source": "/api/households/leave",
      "destination": "/api/household-api?householdRoute=leave"
    },
    {
      "source": "/api/households/invites",
      "destination": "/api/household-api?householdRoute=invites"
    },
    {
      "source": "/api/households/transfer-owner",
      "destination": "/api/household-api?householdRoute=transfer-owner"
    },
    {
      "source": "/api/households/cancel-pending",
      "destination": "/api/household-api?householdRoute=cancel-pending"
    },
    {
      "source": "/api/households/deduplicate-ingredients",
      "destination": "/api/household-api?householdRoute=deduplicate-ingredients"
    },
    {
      "source": "/api/households/members/:uid",
      "destination": "/api/household-api?householdRoute=members&uid=:uid"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/public/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
